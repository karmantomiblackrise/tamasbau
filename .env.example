APP_ENV=production
# Fejlesztéshez állítsd: APP_ENV=development
TB_APP_NAME="Tamás Bau Kft."
TB_APP_URL=http://localhost:8000
TB_CHECKOUT_PAYMENT_PROVIDER=offline

TB_DB_HOST=127.0.0.1
TB_DB_PORT=3306
TB_DB_NAME=tamasbau
TB_DB_USER=root
TB_DB_PASS=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tamás Bau Kft."
MAIL_TIMEOUT=20
MAIL_EHLO_DOMAIN=localhost
TB_DEV_MAIL_LOG=logs/mail-dev.log

# --- Biztonság / 2FA ---
# Legalább 32 karakteres véletlen kulcs (pl. php -r "echo bin2hex(random_bytes(32));")
TB_APP_KEY=
# optional | required  (required: admin/superadmin csak 2FA-val léphet be)
TB_ADMIN_2FA_POLICY=optional
TB_IP_HASH_SALT=
TB_SESSION_HASH_SALT=
TB_ALERT_EMAIL=
# Részletes /api/health.php eléréshez (X-Health-Token fejléc), üresen csak admin sessionnel
TB_HEALTH_TOKEN=

# --- Számlázás (Billingo / Számlázz.hu előkészítés) ---
# none | billingo | szamlazz ; mode: sandbox | live (live csak valódi kulccsal küld)
TB_INVOICE_PROVIDER=none
TB_INVOICE_MODE=sandbox
TB_BILLINGO_API_KEY=
TB_SZAMLAZZ_AGENT_KEY=

# --- Profit / költség ---
TB_LABOR_HOURLY_RATE_HUF=12000
TB_LABOR_HOURLY_COST_HUF=8000
TB_TRAVEL_COST_PER_KM_HUF=150
TB_MIN_MARGIN_PCT=15

# --- SLA (óra, prioritásonként) ---
TB_SLA_HOURS_EMERGENCY=4
TB_SLA_HOURS_HIGH=24
TB_SLA_HOURS_NORMAL=72
TB_SLA_HOURS_LOW=168
